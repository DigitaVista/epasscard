# Store text files with LF line endings in the repository. Checkouts still follow
# each machine's core.autocrlf setting, so Windows working copies are unaffected.
* text=auto

# Binary files: never convert line endings.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.zip  binary
*.tar  binary
*.gz   binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.mp4  binary
*.pdf  binary
